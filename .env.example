# Application
PORT=8181
NODE_ENV=development
API_PREFIX=/api/v1

AUTOMATION_SERVICE_TOKEN=<long-random-string>
AUTOMATION_SERVICE_SCOPES=briefing:write,briefing:read
AUTOMATION_OWNER_ID=<your-user-id>
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/test
# Database
# For development, you can use a local MongoDB or Atlas URI
MONGODB_URI=mongodb://localhost:27017/horizon

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Research & Evidence Integration
# SEC EDGAR requires automated clients to identify a contact (email or URL)
# e.g. Horizon/1.0 (admin@example.com) or Horizon/1.0 (https://horizon.example.com; contact@example.com)
SEC_USER_AGENT=Horizon/1.0 (admin@example.com)

# Optional OpenAI-compatible model provider for research analysis
RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
RESEARCH_LLM_API_KEY=your_api_key_here
RESEARCH_LLM_MODEL=gpt-4o-mini
